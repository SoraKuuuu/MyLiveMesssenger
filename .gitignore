# Storage and runtime user data (chat history, downloads, voice notes, personal avatars)
storage/
**/storage/
*.history

# Build targets and compiler outputs
target/
**/target/
out/
**/out/
*.class

# IDE and Editor configurations
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Archives and temporary files
*.7z
*.zip
*.tar.gz
*.rar
*.log
*.tmp
*.bak

# OS specific files
.DS_Store
Thumbs.db

# Internal skills and scratch directories
skills/
scratch/
